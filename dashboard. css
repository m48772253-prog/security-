
:root {
  --bg: #081713;
  --panel: #102b25;
  --gold: #d9b45b;
  --text: #f4f8f5;
  --muted: #a9c0b7;
  --border: #285344;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: Arial, sans-serif;
  line-height: 1.8;
}

header {
  padding: 35px 7%;
  background: #102b25;
  border-bottom: 1px solid var(--border);
}

header a {
  color: var(--gold);
  text-decoration: none;
}

header h1 {
  margin-bottom: 0;
}

header p {
  color: var(--muted);
}

main {
  width: min(850px, 92%);
  margin: 35px auto;
}

.notice {
  padding: 15px;
  background: #302819;
  border: 1px solid #806b39;
  border-radius: 10px;
  color: #f3d995;
  font-size: 13px;
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 15px;
  margin: 25px 0;
}

.stats article,
.panel {
  background: var(--panel);
  border: 1px solid var(--border);
  padding: 22px;
  border-radius: 15px;
}

.stats span {
  display: block;
  color: var(--muted);
  font-size: 13px;
}

.stats strong {
  display: block;
  font-size: 32px;
  color: var(--gold);
  direction: ltr;
  text-align: right;
}

.bar-background {
  background: #203c32;
  height: 13px;
  border-radius: 20px;
  overflow: hidden;
}

.bar {
  width: 0;
  height: 100%;
  background: var(--gold);
  transition: width .4s;
}

#message {
  color: var(--muted);
  font-size: 13px;
}

button {
  margin-top: 20px;
  padding: 12px 20px;
  border: none;
  border-radius: 9px;
  background: var(--gold);
  color: #15251c;
  font-weight: bold;
  cursor: pointer;
}

footer {
  text-align: center;
  padding: 25px;
  color: var(--muted);
}

@media(max-width:550px) {
  .stats {
    grid-template-columns: 1fr;
  }
}
